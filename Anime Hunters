-- Variáveis de controle
local autoClicking = false
local autoJoinRaid = false
local autoDungeonEasy = false

-- Referência do Remote
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local remote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Signal")

-- Função: pegar NPC mais próximo
local function getClosestNPC()
    local player = game.Players.LocalPlayer
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
        return nil
    end

    local root = player.Character.HumanoidRootPart
    local closest, dist = nil, math.huge

    local clientFolder = workspace:FindFirstChild("Client")
    if clientFolder and clientFolder:FindFirstChild("Enemies") and clientFolder.Enemies:FindFirstChild("World") then
        for _, zone in ipairs(clientFolder.Enemies.World:GetChildren()) do
            for _, npc in ipairs(zone:GetChildren()) do
                if npc:FindFirstChild("HumanoidRootPart") and npc:FindFirstChild("Attributes") then
                    local healthAttr = npc.Attributes:FindFirstChild("Health")
                    if healthAttr and healthAttr.Value > 0 then
                        local d = (npc.HumanoidRootPart.Position - root.Position).Magnitude
                        if d < dist then
                            closest, dist = npc, d
                        end
                    end
                end
            end
        end
    end

    return closest
end

-- Toggle Auto Clicker (unificado)
playerTab:CreateToggle({
   Name = "Auto Clicker",
   CurrentValue = false,
   Flag = "AutoClicker",
   Callback = function(Value)
      autoClicking = Value
      print("Auto Clicker:", autoClicking and "Ativado" or "Desativado")

      if autoClicking then
         task.spawn(function()
            while autoClicking do
               local npc = getClosestNPC()
               if npc and npc:FindFirstChild("Attributes") then
                   local idAttr = npc.Attributes:FindFirstChild("ID")
                   if idAttr then
                       local args = {"General", "Attack", "Click", idAttr.Value}
                       remote:FireServer(unpack(args))
                   end
               end
               task.wait(0.15)
            end
         end)
      end
   end,
})

