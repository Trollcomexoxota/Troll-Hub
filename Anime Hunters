-- Auto Join Dungeon Easy
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local remote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Signal")

local function joinDungeonEasy()
    local args = {"Gamemodes", "Dungeon Easy", "Join"}
    remote:FireServer(unpack(args))
end

task.spawn(function()
    while task.wait(5) do
        if autoDungeonEasy then
            local minuto = os.date("*t").min
            if minuto == 0 then
                print("Tentando entrar na Dungeon Easy...")
                joinDungeonEasy()
            end
        end
    end
end)

playerTab:CreateToggle({
   Name = "Dungeon Easy",
   CurrentValue = false,
   Flag = "AutoDungeonEasy",
   Callback = function(Value)
      autoDungeonEasy = Value
      print("Auto Dungeon Easy:", autoDungeonEasy and "Ativado" or "Desativado")
   end,
})
