playerTab:CreateToggle({
   Name = "Auto Clicker",
   CurrentValue = false,
   Flag = "AutoClicker",
   Callback = function(Value)
      autoClicking = Value
      print("Auto Clicker:", autoClicking and "Ativado" or "Desativado")

