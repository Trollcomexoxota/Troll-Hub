               game:GetService("ReplicatedStorage")
                  :WaitForChild("Remotes")
                  :WaitForChild("Signal")
                  :FireServer(unpack(args))

               task.wait(0.1)
            end
         end)
      end
   end,
})

--------------------------------------------------------------------------------
-- Auto Clicker que ataca NPCs automaticamente (usando Attribute "ID")
--------------------------------------------------------------------------------
playerTab:CreateToggle({
   Name = "Auto Clicker NPCs",
   CurrentValue = false,
   Flag = "AutoClickerNPCs",
   Callback = function(Value)
      autoClickingNPC = Value
      print("Auto Clicker NPCs:", autoClickingNPC and "Ativado" or "Desativado")

      if autoClickingNPC then
         task.spawn(function()
            while autoClickingNPC do
               local npc = getClosestNPC()
               if npc then
                   local id = npc:GetAttribute("ID")
                   if id then
                       local args = {"General", "Attack", "Click", id}
                       game:GetService("ReplicatedStorage")
                           :WaitForChild("Remotes")
                           :WaitForChild("Signal")
                           :FireServer(unpack(args))
                   end
               end
               task.wait(0.15) -- intervalo de ataques
            end
         end)
      end
   end,
})

