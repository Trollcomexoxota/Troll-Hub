-- Criação da aba (ícone corrigido: 0 = sem ícone)
local playerTab = Window:CreateTab("Player", 0)

-- Garantia de que a aba foi criada
if not playerTab then
    warn("Erro: a aba Player não foi criada corretamente!")
    return
end

-- Variáveis de controle
local autoClicking = false
local autoJoinRaid = false
local autoDungeonEasy = false

-- Toggle Auto Clicker
playerTab:CreateToggle({
   Name = "Auto Clicker",
   CurrentValue = false,
   Flag = "AutoClicker",
   Callback = function(Value)
      autoClicking = Value
      print("Auto Clicker:", autoClicking and "Ativado" or "Desativado")

      if autoClicking then
         task.spawn(function()
            while autoClicking do
               local args = {
                  "General",
                  "Attack",
                  "Click"
               }
               game:GetService("ReplicatedStorage")
                  :WaitForChild("Remotes")
                  :WaitForChild("Signal")
                  :FireServer(unpack(args))

               task.wait(0.1)
            end
         end)
      end
   end,
})

