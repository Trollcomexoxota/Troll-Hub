-- Aba Player
local playerTab = Window:CreateTab("Player", 4483362458)

-- Variáveis de controle
local autoClicking = false
local autoJoinRaid = false

-- Toggle Auto Clicker
local ToggleClick = playerTab:CreateToggle({
   Name = "Auto Clicker",
   CurrentValue = false,
   Flag = "AutoClicker",
   Callback = function(Value)
      autoClicking = Value
      print("Auto Clicker:", autoClicking and "Ativado" or "Desativado")

      if autoClicking then
         task.spawn(function()
            while autoClicking do
               local args = {
                  "General",
                  "Attack",
                  "Click"
               }
               game:GetService("ReplicatedStorage")
                  :WaitForChild("Remotes")
                  :WaitForChild("Signal")
                  :FireServer(unpack(args))

               task.wait(0.1) -- intervalo de cliques
            end
         end)
      end
   end,
})

-- Toggle Auto Join Raid
local ToggleRaid = playerTab:CreateToggle({
   Name = "Auto Join Raid",
   CurrentValue = false,
   Flag = "AutoJoinRaid",
   Callback = function(Value)
      autoJoinRaid = Value
      print("Auto Join Raid:", autoJoinRaid and "Ativado" or "Desativado")

      if autoJoinRaid then
         task.spawn(function()
            while autoJoinRaid do
               local args = {
                  "Gamemodes",
                  "Raid",
                  "Join"
               }
               game:GetService("ReplicatedStorage")
                  :WaitForChild("Remotes")
                  :WaitForChild("Signal")
                  :FireServer(unpack(args))

               task.wait(5) -- intervalo entre tentativas de entrar na raid
            end
         end)
      end
   end,
})
